<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome | CSPC Lost And Found</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="portal-page">
    <main class="portal-card">
        <img src="/images/logo.png" alt="CSPC Logo" class="portal-logo"
             onerror="this.style.display='none'">
        <h1>Camarines Sur Polytechnic Colleges</h1>
        <h2>Nabua, Camarines Sur</h2>
        <p class="portal-system">Campus Lost And Found System</p>

        <nav class="portal-buttons" aria-label="Choose how to log in">
            <a href="/login?as=admin" class="portal-button">Administrator</a>
            <a href="/login?as=student" class="portal-button">Student</a>
        </nav>

        <p class="portal-guest">
            Just looking? <a href="/items">Browse lost and found items</a>
        </p>
    </main>
</body>
</html>
